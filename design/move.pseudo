START PROGRAM

SET current_room = "Airlock Bay"
SET inventory = empty list []

DEFINE rooms dictionary mapping each room to its valid directions and items:
    "Airlock Bay": {North: "Research Lab", South: "Medbay", East: "Engineering Deck", West: "Crew Quarters"}
    "Research Lab": {South: "Airlock Bay", Item: "Data Chip"}
    "Crew Quarters": {East: "Airlock Bay", Item: "Access Keycard"}
    "Engineering Deck": {West: "Airlock Bay", South: "Cargo Hold", Item: "Plasma Torch"}
    "Cargo Hold": {North: "Engineering DEck", Item: "Power Cell"}
    "Medbay": {North: "Airlock Bay", South: "Armormy", Item: "Bio Scanner"}
    "Armory": {North: "Medbay", East: "Command Bridge", Item: "EMP Grenade"}
    "Command Bridge" {West: "Armory", Villain: "Rogue Security AI"}

WHILE game_is_running is TRUE:
    DISPLAY "You are in the " + current+room
    DISPLAY "Inventory: " + intentory
    IF current_room has an item AND item is not in inventory:
        DISPLAY "You see a " + itme
    DISPLAY "----------------------"

    PROMPT player: "Enter your move (go North, go South, go East, go West):"
    READ player_input

    IF player_input starts with "go ":
        EXTRACT direction from player_input (e.g., "North")

        IF direction is a calid exit in rooms[current_room]:
            SET current_room = rooms[current_room][direction]

            IF current_room == "Command Bridge":
                IF length of inventory == 6:
                    DISPLAY "You used all 6 components to shut down the Rogue AI. YOU WIN!"
                ELSE:
                    DISPLAY "The Rogue AI detected you before you had all items. GAME OVER!" 
                SET game_is_running = FALSE
        ELSE: 
            DISPLAY "You can't go that way!"
   ELSE:
       DISPLAY "Invalid input! Please enter 'go [Direction]'."

END PROGRAM
