START PROGRAM

# Assumes current_room. rooms dictionary, and inventory list are initialized

WHILE game_is_running is TRUE:
    DISPLAY "You are in the " + current_room
    DISPLAY "Inventory: " + inventory
    IF rooms[current_room] contains an "Item":
        DISPLAY "You see a " + rooms[current_room]["Item"]
    DISPLAY "-----------------------"

    PROMPT player: "Enter your command (get [Item Name]):"
    READ player_input

    IF player_input starts with "get ":
        EXTRACT item_name from player_input (e.g., "Data Chip")

        IF rooms[current_room] has an "Item" AND rooms[current_room]["Item"] == item_name:
            IF item_name is NOT already in inventory:
                APPEND item_name to inventory
                REMOVE "Item" from rooms[current_room]
                DISPLAY item_name + " retrieved!"
            ELSE: 
                DISPLAY "You already have that item!"
        ELSE:
            DISPLAY "Can't get " + item_name + "!"
    ELSE:
        DISPLAY "Invalid input! Please use the format 'get [Item Name'."

END PROGRAM
